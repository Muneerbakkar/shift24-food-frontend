# Backend API URL (e.g. your Render backend URL with /api suffix)
VITE_API_BASE_URL=https://shift24-food-backend.onrender.com/api

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Key ID (Optional fallback - loaded dynamically from backend API)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
